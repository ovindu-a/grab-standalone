<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="32dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/app_name"
        android:textColor="@color/accent_purple"
        android:textSize="38sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/tvConnectedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Glasses connected"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Spacer pushes input to vertical center -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Phone number input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPhoneNumber"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone number"
        app:boxStrokeColor="@color/accent_purple"
        app:boxStrokeWidth="2dp"
        app:hintTextColor="@color/text_muted">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="18sp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Call button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCall"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Call"
        android:textSize="17sp"
        android:textColor="@color/white"
        android:fontFamily="sans-serif-medium"
        app:backgroundTint="@color/accent_purple"
        app:cornerRadius="12dp" />

    <!-- Spacer pushes disconnect to bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Disconnect -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDisconnect"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Disconnect glasses"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

</LinearLayout>
