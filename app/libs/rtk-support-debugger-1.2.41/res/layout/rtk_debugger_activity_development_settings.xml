<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/AwesomeToolBar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:titleTextAppearance="@style/ActionBar.TitleText" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/developerOptionsCardView"
                app:cardBackgroundColor="@color/md_theme_surfaceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_small"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/margin_small">

                    <TextView
                        style="@style/TextAppearance.MaterialComponents.Subtitle2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:padding="@dimen/margin_small"
                        android:text="@string/rtk_text_use_developer_optoins" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDeveloperOptions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/deviceCertificationCardView"
                android:layout_width="match_parent"
                app:cardBackgroundColor="@color/md_theme_surfaceContainer"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_small"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/margin_small">

                    <TextView
                        style="@style/TextAppearance.MaterialComponents.Subtitle2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:padding="@dimen/margin_small"
                        android:text="@string/rtk_text_label_device_certification" />

                    <TextView
                        android:id="@+id/tvDeviceCertificationState"
                        style="@style/TextAppearance.MaterialComponents.Body2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginStart="@dimen/margin_small"
                        android:padding="@dimen/margin_small"
                        android:drawablePadding="@dimen/margin_small"
                        android:text="@string/rtk_text_label_device_certification"
                        app:drawableEndCompat="@mipmap/rtk_support_ic_arrow_right" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/systemFragment"
                android:name="com.realtek.sdk.support.debugger.settings.DevelopmentPreferenceFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/logFragment"
                android:name="com.realtek.sdk.support.debugger.settings.LogPreferenceFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>