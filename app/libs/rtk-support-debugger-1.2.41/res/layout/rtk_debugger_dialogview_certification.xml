<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/margin_medium">

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etCertificationCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/rtk_dfu_quality_hint_certification"
        android:inputType="numberDecimal"
        android:padding="@dimen/margin_small"
        android:textColor="@color/md_theme_onSurface"  />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/etCertificationCode"
        android:layout_marginTop="@dimen/margin_medium">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/rtk_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_weight="3"
            android:text="@string/rtksdk_button_submit" />
    </LinearLayout>

</RelativeLayout>