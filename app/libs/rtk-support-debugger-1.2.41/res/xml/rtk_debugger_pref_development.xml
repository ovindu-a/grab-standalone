<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="development_preference_screen"
    android:title="@string/rtk_pref_title_developer_optoins">

    <PreferenceCategory
        android:title="@string/rtk_pref_title_category_sys_settings"
        app:iconSpaceReserved="false">

        <!-- Developer Options -->
        <Preference
            android:key="rtk_sys_settings_device_info"
            android:summary="@string/rtk_pref_title_device_info_summary"
            android:title="@string/rtk_pref_title_device_info"
            app:iconSpaceReserved="false">
            <intent android:action="android.settings.DEVICE_INFO_SETTINGS" />
        </Preference>

        <!-- Developer Options -->
        <Preference
            android:key="rtk_sys_settings_developer_options"
            android:summary="@string/rtk_pref_title_developer_options_summary"
            android:title="@string/rtk_pref_title_developer_optoins"
            app:iconSpaceReserved="false">
            <intent android:action="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" />
        </Preference>

        <!-- Bluetooth Settings -->
        <Preference
            android:key="rtk_sys_settings_bluetooth"
            android:summary="@string/rtk_pref_title_sys_settings_bluetooth_summary"
            android:title="@string/rtk_pref_title_sys_settings_bluetooth"
            app:iconSpaceReserved="false">
            <intent android:action="android.settings.BLUETOOTH_SETTINGS" />
        </Preference>
        <!-- Location Settings -->
        <Preference
            android:key="rtk_sys_settings_location"
            android:summary="@string/rtk_pref_title_sys_settings_location_summary"
            android:title="@string/rtk_pref_title_sys_settings_location"
            app:iconSpaceReserved="false">
            <intent android:action="android.settings.LOCATION_SOURCE_SETTINGS" />
        </Preference>

        <Preference
            android:key="rtk_app_debugger_settings"
            android:summary="@string/rtk_pref_title_sys_debugger_settings"
            android:title="@string/rtk_pref_title_sys_settings_location"
            app:iconSpaceReserved="false">
            <intent android:action="rtk.action.settings.APPLICATION_DEBUGGER_SETTINGS" />
        </Preference>
    </PreferenceCategory>
</PreferenceScreen>