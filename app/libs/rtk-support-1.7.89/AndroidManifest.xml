<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.realsil.sdk.support" >

    <uses-sdk android:minSdkVersion="19" />

    <application
        android:allowBackup="true"
        android:supportsRtl="true" >

        <!-- fix: Error inflating class android.webkit.WebView -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="true" />

        <activity
            android:name="com.realsil.sdk.support.scanner.LeScannerActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|locale|layoutDirection"
            android:label="@string/rtksdk_title_scanner" />
        <activity
            android:name="com.realsil.sdk.support.scanner.LegacyScannerActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|locale|layoutDirection"
            android:label="@string/rtksdk_title_scanner" />
        <activity
            android:name="com.realsil.sdk.support.scanner.ScannerSettingsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|locale|layoutDirection"
            android:exported="true"
            android:label="@string/rtksdk_title_scanner" >
            <intent-filter android:priority="1" >

                <!-- android.content.ActivityNotFoundException: No Activity found to handle Intent { act=rtk.settings.DEVELOPMENT_SETTINGS } -->
                <action android:name="rtk.action.settings.BT_SCAN_FILTER" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.realsil.sdk.support.permission.PermissionActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|locale|layoutDirection"
            android:label="@string/rtk_support_title_permission" >

            <!-- <intent-filter android:priority="1"> -->
            <!-- &lt;!&ndash;android.content.ActivityNotFoundException: No Activity found to handle Intent { act=rtk.settings.DEVELOPMENT_SETTINGS }&ndash;&gt; -->
            <!-- <action android:name="rtk.action.settings.BT_SCAN_FILTER"/> -->
            <!-- <action android:name="rtk.action.settings.DEVELOPER_OPTIONS"/> -->
            <!-- <category android:name="android.intent.category.DEFAULT" /> -->
            <!-- </intent-filter> -->
        </activity>
        <activity
            android:name="com.realsil.sdk.support.ui.LocalAssetHtmlActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|locale|layoutDirection"
            android:label="@string/rtk_title_device_info" >
        </activity>
        <activity
            android:name="com.realsil.sdk.support.privacy.UserAgreementActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|locale|layoutDirection" />
        <activity
            android:name="com.realsil.sdk.support.privacy.PrivacyPolicyActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|locale|layoutDirection" />
    </application>

</manifest>