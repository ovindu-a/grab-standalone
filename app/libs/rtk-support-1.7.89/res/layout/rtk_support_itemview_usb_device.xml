<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notificationCard"
    app:cardBackgroundColor="@color/md_theme_surfaceContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_small"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="8dp"
    app:cardPreventCornerOverlap="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:padding="@dimen/margin_small"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/textview_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text=""
            android:textColor="@color/material_black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textview_device_class"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textview_name"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/margin_small"
            android:text=""
            android:textColor="@color/primaryColor"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textview_manufacturer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textview_name"
            android:layout_toEndOf="@+id/textview_device_class"
            android:text=""
            android:textColor="@color/material_black"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textview_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textview_manufacturer_name"
            android:layout_alignParentStart="true"
            android:text=""
            android:textColor="@color/material_grey_500"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/rssi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:scaleType="center"
            android:src="@drawable/rtk_support_ic_rssi_bar"
            tools:ignore="contentDescription" />


        <TextView
            android:id="@+id/textview_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textview_name"
            android:layout_toStartOf="@id/rssi"
            android:layout_toEndOf="@+id/textview_address"
            android:paddingStart="@dimen/margin_tiny"
            android:paddingEnd="@dimen/margin_tiny"
            android:text=""
            android:textColor="@color/material_grey_500"
            android:textSize="12sp" />
    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>