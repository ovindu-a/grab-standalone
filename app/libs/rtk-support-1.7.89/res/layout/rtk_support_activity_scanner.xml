<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContentView"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/toolbarActionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/RtkAppTheme.AppBarOverlay">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/mToolbar"
            style="@style/AwesomeToolBar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            app:titleTextAppearance="@style/ActionBar.TitleText">

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <TextView
        android:id="@+id/tv_device_bluetooth_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_small"
        android:text="@string/rtksdk_device_bluetooth_address"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvLocationTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/material_red_500"
        android:padding="@dimen/margin_small"
        android:text="@string/rtk_support_location_off_tip"
        android:textColor="@color/material_white"
        android:visibility="gone"
        app:drawableEndCompat="@mipmap/rtk_support_ic_arrow_right" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mRecyclerView"
        android:layout_margin="@dimen/margin_small"
        tools:listitem="@layout/rtksdk_scanner_device"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
