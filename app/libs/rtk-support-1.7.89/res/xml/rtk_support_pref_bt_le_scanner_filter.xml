<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="development_preference_screen"
    android:title="@string/rtk_pref_title_scan_filter">

    <com.realsil.sdk.support.settings.RtkListPreference
        android:entries="@array/rtk_pref_bt_scan_mechanism_entries"
        android:entryValues="@array/rtk_pref_bt_scan_mechanism_values"
        android:key="rtk_list_bt_scan_mechanism"
        android:summary="{v}"
        android:title="@string/rtk_pref_title_bt_scan_mechanism"
        app:iconSpaceReserved="false" />

    <androidx.preference.SwitchPreference
        android:key="rtk_switch_bt_scan_filter_connectable"
        android:summary="是否打开我呢？"
        android:summaryOff="@string/rtk_summaryOff"
        android:summaryOn="@string/rtk_summaryOn"
        android:switchTextOff="@string/rtk_switchTextOff"
        android:switchTextOn="@string/rtk_switchTextOn"
        android:title="@string/rtk_pref_title_bt_scan_filter_connectable"
        app:iconSpaceReserved="false" />


    <androidx.preference.EditTextPreference
        android:dialogTitle="@string/rtk_pref_title_bt_scan_filter_addr"
        android:digits="0123456789:abcdefABCDEF"
        android:inputType="text"
        android:key="rtk_edittext_bt_scan_filter_address"
        android:summary="{v}"
        android:title="@string/rtk_pref_title_bt_scan_filter_addr"
        app:iconSpaceReserved="false" />

    <PreferenceCategory
        android:title="@string/rtk_pref_category_title_bt_scan_filter_device_name"
        app:iconSpaceReserved="false">

        <androidx.preference.SwitchPreference
            android:key="rtk_switch_bt_scan_filter_name_nullable"
            android:summary="是否打开我呢？"
            android:summaryOff="@string/rtk_summaryOff"
            android:summaryOn="@string/rtk_summaryOn"
            android:switchTextOff="@string/rtk_switchTextOff"
            android:switchTextOn="@string/rtk_switchTextOn"
            android:title="@string/rtk_pref_title_bt_scan_filter_name_nullable"
            app:iconSpaceReserved="false" />

        <androidx.preference.EditTextPreference
            android:dialogTitle="@string/rtk_pref_title_bt_scan_filter_name"
            android:inputType="text"
            android:key="rtk_edittext_bt_scan_filter_name"
            android:summary="{v}"
            android:title="@string/rtk_pref_title_bt_scan_filter_name"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/rtk_pref_title_bt_scan_filter_service_uuid"
        app:iconSpaceReserved="false">

        <androidx.preference.SwitchPreference
            android:key="rtk_switch_bt_scan_filter_hogp_service"
            android:summary="是否打开我呢？"
            android:summaryOff="@string/rtk_pref_title_bt_scan_filter_service_uuid_hogp_summary"
            android:summaryOn="@string/rtk_pref_title_bt_scan_filter_service_uuid_hogp_summary"
            android:switchTextOff="@string/rtk_switchTextOff"
            android:switchTextOn="@string/rtk_switchTextOn"
            android:title="@string/rtk_pref_title_bt_scan_filter_service_uuid_hogp"
            app:iconSpaceReserved="false" />

        <androidx.preference.EditTextPreference
            android:dialogTitle="@string/rtk_pref_title_bt_scan_filter_service_uuid"
            android:digits="0123456789-"
            android:inputType="text"
            android:key="rtk_edittext_bt_scan_filter_uuid"
            android:summary="{v}"
            android:title="@string/rtk_pref_title_bt_scan_filter_service_uuid"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>


    <PreferenceCategory
        android:title="@string/rtk_pref_category_title_bt_scan_filter_rssi"
        app:iconSpaceReserved="false">

        <androidx.preference.SwitchPreference
            android:key="KEY_BT_SCAN_FILTER_RSSI_ENABLED"
            android:summary="是否打开我呢？"
            android:summaryOff="@string/rtk_summaryOff"
            android:summaryOn="@string/rtk_summaryOn"
            android:switchTextOff="@string/rtk_switchTextOff"
            android:switchTextOn="@string/rtk_switchTextOn"
            android:title="@string/rtk_pref_title_bt_scan_filter_rssi_enabled"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            android:defaultValue="0"
            android:key="KEY_BT_SCAN_FILTER_RSSI_VALUE"
            android:max="-10"
            android:summary=""
            android:title="@string/rtk_pref_title_bt_scan_filter_rssi"
            app:iconSpaceReserved="false"
            app:min="-100"
            app:showSeekBarValue="true" />
    </PreferenceCategory>


    <androidx.preference.SwitchPreference
        android:key="rtk_switch_bt_scan_filter_sort"
        android:summary="是否打开我呢？"
        android:summaryOff="@string/rtk_summaryOff"
        android:summaryOn="@string/rtk_summaryOn"
        android:switchTextOff="@string/rtk_switchTextOff"
        android:switchTextOn="@string/rtk_switchTextOn"
        android:title="@string/rtk_pref_title_bt_scan_filter_sort"
        app:iconSpaceReserved="false" />
</androidx.preference.PreferenceScreen>